# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# Auth
JWT_SECRET=<openssl rand -hex 32>

# GCP / Vertex AI + GCS
GCP_PROJECT_ID=
# Default region — used by Lyria (music). Lyria 2 is not on `global`.
GCP_LOCATION=us-central1
# Region for text generation. Default `global`. REQUIRED to be `global` if
# you keep the preview text model (gemini-3-flash-preview) — that model is
# not provisioned on regional endpoints.
GCP_TEXT_LOCATION=global
# Region for multi-turn image generation. Default `global`. REQUIRED to be
# `global` for gemini-3.1-flash-image-preview (NB2). Same probe applies.
GCP_IMAGE_LOCATION=global
GCP_SERVICE_ACCOUNT_KEY=<JSON base64>
GCS_BUCKET=

# Vertex AI model overrides (optional — defaults in GeminiProvider.ts).
# Set these to swap to GA models without a code change if Vertex deprecates
# the preview models. Defaults at the time of writing:
#   - text:     gemini-3-flash-preview          (PREVIEW)
#   - image:    gemini-2.5-flash-image          (GA)
#   - NB2:      gemini-3.1-flash-image-preview  (PREVIEW)
#   - music:    lyria-002                        (GA)
# Recommended GA fallbacks if the preview models go away:
#   GEMINI_TEXT_MODEL=gemini-2.5-flash
#   GEMINI_NB2_MODEL=gemini-2.5-flash-image    (note: single-turn shape)
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=
GEMINI_NB2_MODEL=
GEMINI_MUSIC_MODEL=

# TURN server (GCP VM 34.118.27.119)
TURN_HOST=34.118.27.119
TURN_STATIC_AUTH_SECRET=testsecret123

# Client (Vite env vars)
VITE_API_URL=http://localhost:3001
VITE_WSS_URL=ws://localhost:3001
VITE_TURN_CONFIG_URL=http://localhost:3001/turn-config
