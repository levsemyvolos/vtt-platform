{
  "name": "vtt-platform",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "type-check": "pnpm -r --parallel --if-present run type-check",
    "lint": "pnpm -r --parallel --if-present run lint",
    "test": "pnpm -r --parallel --if-present run test",
    "dev": "pnpm -r --parallel run dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "bcrypt"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "artillery": "^2.0.31",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "@playwright/test": "^1.59.1",
    "playwright": "^1.59.1"
  }
}
