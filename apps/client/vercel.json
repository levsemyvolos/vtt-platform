{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter @vtt/client build",
  "outputDirectory": "dist",
  "installCommand": "echo \"install handled inside buildCommand from monorepo root\"",
  "framework": null,
  "build": {
    "env": {
      "VITE_API_URL": "@vite_api_url",
      "VITE_WSS_URL": "@vite_wss_url",
      "VITE_TURN_CONFIG_URL": "@vite_turn_config_url"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
