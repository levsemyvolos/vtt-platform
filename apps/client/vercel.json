{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter @vtt/client build",
  "outputDirectory": "dist",
  "installCommand": "echo \"install handled inside buildCommand from monorepo root\"",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://vtt-server-x7b4y4suwq-lm.a.run.app/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
