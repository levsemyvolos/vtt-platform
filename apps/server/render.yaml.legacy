# Render Blueprint — VTT Platform App Server (legacy, replaced by Cloud Run)
# Runtime: Node.js 20 LTS — direct execution via tsx (no tsc build step).
#
# Reads env from Render's process environment — apps/server/package.json:start
# is `tsx src/index.ts` (no --env-file flag).
services:
  - type: web
    name: vtt-server
    runtime: node
    region: frankfurt
    plan: free
    branch: main
    autoDeploy: true
    healthCheckPath: /health
    # Free tier does not support preDeployCommand. Migrations also cannot run
    # from Render against Supabase Free, because Supabase Free exposes the
    # direct connection (5432) only via IPv6 and Render Free instances are
    # IPv4-only. The Transaction pooler (6543) used at runtime via DATABASE_URL
    # is incompatible with Prisma DDL through PgBouncer transaction-mode.
    # Workaround for MVP: run `prisma migrate deploy` locally once against the
    # Supabase Direct URL, then redeploy. Promote to a build-time migration
    # after upgrading to Starter+ (which supports preDeployCommand).
    buildCommand: |
      corepack enable
      corepack prepare pnpm@9.12.0 --activate
      pnpm install --frozen-lockfile
      pnpm --filter @vtt/server exec prisma generate
    startCommand: pnpm --filter @vtt/server start
    envVars:
      - key: NODE_VERSION
        value: 20.18.0
      - key: PORT
        value: 4000
      - key: DATABASE_URL
        sync: false
      - key: JWT_SECRET
        generateValue: true
      - key: CLIENT_URL
        sync: false
      - key: GCP_PROJECT_ID
        sync: false
      - key: GCP_LOCATION
        value: us-central1
      - key: GCP_SERVICE_ACCOUNT_KEY
        sync: false
      - key: GCS_BUCKET
        sync: false
      - key: TURN_HOST
        sync: false
      - key: TURN_REALM
        sync: false
      - key: TURN_STATIC_AUTH_SECRET
        sync: false
