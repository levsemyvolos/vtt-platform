// VTT Platform — Prisma Schema
// Database: PostgreSQL
// Spec: §2.15

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  lobby
  active
  closed
}

enum AudioLayer {
  music
  ambient
  sfx
}

enum MessageMode {
  normal
  ic
  ooc
  whisper
  secret_roll
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  passwordHash String   @db.VarChar(60)
  displayName  String   @db.VarChar(64)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  ownedRooms        Room[]
  sessions          Session[]
  characters        Character[]
  journalAuthored   JournalEntry[]     @relation("JournalAuthor")
  journalRecipients JournalRecipient[] @relation("JournalRecipient")
  assignedTokens    Token[]            @relation("TokenAssignedUser")
  sentMessages      ChatMessage[]      @relation("ChatMessageSender")
  receivedMessages  ChatMessage[]      @relation("ChatMessageRecipient")
  assets            Asset[]            @relation("AssetOwner")
  roomMemberships   RoomMember[]
  assistantConversations AssistantConversation[]
  assistantMessages AssistantMessage[]
  assistantImageConversations AssistantImageConversation[]
}

model Room {
  id                  String   @id @default(uuid()) @db.Uuid
  ownerId             String   @db.Uuid
  name                String   @db.VarChar(128)
  gameSystem          String     @db.VarChar(64) @default("D&D 5e")
  status              RoomStatus @default(lobby)
  inviteTokenPlayer   String     @unique @db.VarChar(64)
  inviteTokenObserver String   @unique @db.VarChar(64)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  lastActiveAt        DateTime @default(now()) @db.Timestamptz(6)

  owner             User               @relation(fields: [ownerId], references: [id])
  scenes            Scene[]
  messages          ChatMessage[]
  journalEntries    JournalEntry[]
  audioTracks       AudioTrack[]
  characters        Character[]
  assets            Asset[]            @relation("AssetRoom")
  members           RoomMember[]
  assistantMessages AssistantMessage[]
  assistantConversations AssistantConversation[]
  assistantImageConversations AssistantImageConversation[]

  @@index([ownerId, lastActiveAt(sort: Desc)])
}

/// Persistent player membership — written on invite-join, used for lobby roster
/// and for listing rooms the user was invited to (R-Persistent-Membership).
model RoomMember {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  userId    String   @db.Uuid
  role      String   @db.VarChar(16) @default("Player")
  joinedAt  DateTime @default(now()) @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

enum AssetSource {
  UPLOAD
  AI_IMAGE
  AI_AUDIO
}

model Asset {
  id           String      @id @default(uuid()) @db.Uuid
  ownerId      String      @db.Uuid
  roomId       String      @db.Uuid
  mimeType     String      @db.VarChar(128)
  size         BigInt
  // storageKey is the immutable GCS object path (rooms/<uuid>/<kind>/<uuid>.<ext>).
  // It MUST stay UUID-based for storage stability — rename UI mutates `originalName` only.
  storageKey   String      @unique @db.VarChar(256)
  // Display name shown in the asset library. Backfilled from storageKey suffix
  // for rows created before the rename feature; new uploads carry file.originalname.
  originalName String      @default("") @db.VarChar(128)
  source       AssetSource @default(UPLOAD)
  aiPrompt     String?     @db.Text
  aiModel      String?     @db.VarChar(64)
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)

  owner            User           @relation("AssetOwner", fields: [ownerId], references: [id])
  room             Room           @relation("AssetRoom", fields: [roomId], references: [id], onDelete: Cascade)
  sceneBackgrounds   Scene[]              @relation("SceneBackground")
  tokenImages        Token[]              @relation("TokenImage")
  characterPdfs      Character[]          @relation("CharacterPdf")
  journalEntries     JournalEntry[]       @relation("JournalAsset")
  audioTracks        AudioTrack[]
  imageTurnGenerated AssistantImageTurn[] @relation("ImageTurnGenerated")

  @@index([roomId, source, createdAt])
  @@index([ownerId])
}

model Scene {
  id                String   @id @default(uuid()) @db.Uuid
  roomId            String   @db.Uuid
  name              String   @db.VarChar(128)
  backgroundAssetId String?  @db.Uuid
  backgroundFit     String   @default("cover")
  backgroundOffsetX Float    @default(0)
  backgroundOffsetY Float    @default(0)
  backgroundScale   Float    @default(1.0)
  gridSize          Int
  // Scene grid dimensions in cells — used by FoW algorithm A4 (visibility[W][H]).
  gridWidth         Int      @default(40)
  gridHeight        Int      @default(40)
  gridVisible       Boolean  @default(true)
  // FoW shape-list (Ф3.3): array of {id,x,y,w,h,mode,createdAt} composed in
  // createdAt ASC order. null/[] = fully revealed. Replaces legacy fogMaskBase64.
  fogShapes         Json?
  isHidden          Boolean  @default(false)
  isActive          Boolean  @default(false)
  // Current combat round; incremented on wraparound advanceTurn (Ф7.3, A_Initiative).
  currentRound      Int      @default(1)
  // Persisted free-draw strokes (Ф3.4.2). Stored as DrawStroke[] JSON array; null = empty.
  annotations       Json?
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  room            Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  backgroundAsset Asset?             @relation("SceneBackground", fields: [backgroundAssetId], references: [id], onDelete: SetNull)
  tokens          Token[]
  initiativeItems InitiativeEntry[]
  audioTracks     AudioTrack[]

  @@index([roomId])
}

model Token {
  id             String   @id @default(uuid()) @db.Uuid
  sceneId        String   @db.Uuid
  assignedUserId String?  @db.Uuid
  imageAssetId   String?  @db.Uuid
  x              Float
  y              Float
  name           String   @db.VarChar(64)
  hp             Int?
  maxHp          Int?
  color          String?
  statusMarkers  String[] @default([])
  isHidden       Boolean  @default(false)
  // OCC version per algorithm A2 (§2.17.3). Monotonically increasing on every accepted move.
  version        Int      @default(0)
  visionRadius   Int      @default(6)

  scene             Scene            @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  assignedUser      User?            @relation("TokenAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  imageAsset        Asset?           @relation("TokenImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  initiativeEntries InitiativeEntry[] @relation("InitiativeEntryToken")

  @@index([sceneId])
  @@index([assignedUserId])
}

model Character {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  roomId      String   @db.Uuid
  name        String   @db.VarChar(128)
  sheetData   Json
  pdfAssetId  String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  owner    User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  room     Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  pdfAsset Asset? @relation("CharacterPdf", fields: [pdfAssetId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([ownerId])
}

model ChatMessage {
  id          String      @id @default(uuid()) @db.Uuid
  roomId      String      @db.Uuid
  senderId    String?     @db.Uuid
  mode        MessageMode
  body        String      @db.Text
  rollPayload Json?
  recipientId String?     @db.Uuid
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)

  room      Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User? @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipient User? @relation("ChatMessageRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([recipientId])
}

model AudioTrack {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  sceneId   String?  @db.Uuid
  title     String   @db.VarChar(128)
  assetId   String   @db.Uuid
  loop      Boolean    @default(false)
  fadeMs    Int        @default(1500)
  layer     AudioLayer @default(music)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)

  room    Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  scene   Scene? @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([sceneId])
}

enum JournalVisibility {
  private
  shared
}

model JournalEntry {
  id         String            @id @default(uuid()) @db.Uuid
  roomId     String            @db.Uuid
  authorId   String            @db.Uuid
  title      String            @db.VarChar(128)
  body       String            @db.Text
  visibility JournalVisibility @default(private)
  assetId    String?           @db.Uuid
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(6)

  room       Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author     User               @relation("JournalAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  asset      Asset?             @relation("JournalAsset", fields: [assetId], references: [id], onDelete: SetNull)
  recipients JournalRecipient[]

  @@index([roomId])
}

model JournalRecipient {
  entryId   String   @db.Uuid
  userId    String   @db.Uuid
  grantedAt DateTime @default(now()) @db.Timestamptz(6)

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User         @relation("JournalRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@id([entryId, userId])
}

model InitiativeEntry {
  id         String  @id @default(uuid()) @db.Uuid
  sceneId    String  @db.Uuid
  name       String  @db.VarChar(64)
  initiative Int
  orderIndex Int
  isCurrent  Boolean @default(false)
  tokenId    String? @db.Uuid

  scene Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  token Token? @relation("InitiativeEntryToken", fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([tokenId])
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String   @db.VarChar(128)
  issuedAt         DateTime @default(now()) @db.Timestamptz(6)
  expiresAt        DateTime @db.Timestamptz(6)
  userAgent        String   @db.VarChar(256)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/// Persistent AI assistant chat messages per room (§2.15, Ф8.1).
/// F5-safe: history is loaded from DB on mount, not from Redux only.
model AssistantMessage {
  id             String   @id @default(uuid()) @db.Uuid
  roomId         String   @db.Uuid
  userId         String?  @db.Uuid
  conversationId String   @db.Uuid
  /// 'user' | 'assistant' | 'system'
  role           String   @db.VarChar(16)
  /// 'npc-description' | 'scene-description' | 'srd-lookup' | 'free-chat'
  context        String   @db.VarChar(32)
  content        String   @db.Text
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  room         Room                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([conversationId, createdAt])
}

/// AI assistant conversation thread per room. Replaces the implicit
/// `${roomId}:${context}` keying with first-class persistence so that
/// users can rename, delete, and run multiple parallel threads of the
/// same context in the same room (Ф8.1, AI-rework Session 1.1).
model AssistantConversation {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  ownerId   String   @db.Uuid
  /// 'npc-description' | 'scene-description' | 'srd-lookup' | 'free-chat'
  context   String   @db.VarChar(32)
  title     String   @db.VarChar(120)

  /// Per-conversation default variables (Phase 2a S3.1, P4 backend).
  /// When a request with empty AssistantVariables comes in, server falls back
  /// to these. NULL means "not set" (resolution layer treats as undefined).
  defaultRuleset        String? @db.VarChar(64)
  defaultSetting        String? @db.VarChar(280)
  defaultPlayerLevel    Int?
  defaultTone           String? @db.VarChar(120)
  defaultOutputLanguage String? @db.VarChar(40)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  room     Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  owner    User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([roomId, updatedAt])
  @@index([ownerId])
}

/// Multi-turn image-generation thread (Session 7.1, Nano Banana 2).
/// Each AssistantImageTurn is a (user-prompt, assistant-image) pair, possibly
/// including 0..3 user-uploaded reference assets that the model uses as
/// visual context.
model AssistantImageConversation {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  ownerId   String   @db.Uuid
  title     String   @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  room  Room                    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  owner User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  turns AssistantImageTurn[]

  @@index([roomId, updatedAt])
  @@index([ownerId])
}

model AssistantImageTurn {
  id                  String   @id @default(uuid()) @db.Uuid
  conversationId      String   @db.Uuid
  turnIndex           Int
  userPrompt          String   @db.Text
  /// Asset id of the model-generated image for this turn. NULL while a turn is
  /// in flight (we always insert AFTER the upstream call completes, so this
  /// should be NOT NULL once persisted; but the FK is nullable to allow
  /// pruning of failed generations on retry).
  generatedAssetId    String?  @db.Uuid
  /// JSON array of asset UUIDs the user supplied as visual references.
  /// 0–3 entries enforced at the service layer, not at the DB layer.
  referenceAssetIds   String[] @default([]) @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  conversation AssistantImageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  generated    Asset?                     @relation("ImageTurnGenerated", fields: [generatedAssetId], references: [id], onDelete: SetNull)

  @@unique([conversationId, turnIndex])
  @@index([conversationId, createdAt])
}
