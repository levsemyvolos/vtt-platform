// VTT Platform — Prisma Schema
// Database: PostgreSQL
// Spec: §2.15

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  lobby
  active
  closed
}

enum AudioLayer {
  music
  ambient
  sfx
}

enum MessageMode {
  normal
  ic
  ooc
  whisper
  secret_roll
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  passwordHash String   @db.VarChar(60)
  displayName  String   @db.VarChar(64)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  ownedRooms        Room[]
  sessions          Session[]
  characters        Character[]
  journalAuthored   JournalEntry[]     @relation("JournalAuthor")
  journalRecipients JournalRecipient[] @relation("JournalRecipient")
  assignedTokens    Token[]            @relation("TokenAssignedUser")
  sentMessages      ChatMessage[]      @relation("ChatMessageSender")
  receivedMessages  ChatMessage[]      @relation("ChatMessageRecipient")
  assets            Asset[]            @relation("AssetOwner")
  roomMemberships   RoomMember[]
  assistantMessages AssistantMessage[]
}

model Room {
  id                  String   @id @default(uuid()) @db.Uuid
  ownerId             String   @db.Uuid
  name                String   @db.VarChar(128)
  gameSystem          String     @db.VarChar(64) @default("D&D 5e")
  status              RoomStatus @default(lobby)
  inviteTokenPlayer   String     @unique @db.VarChar(64)
  inviteTokenObserver String   @unique @db.VarChar(64)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  lastActiveAt        DateTime @default(now()) @db.Timestamptz(6)

  owner             User               @relation(fields: [ownerId], references: [id])
  scenes            Scene[]
  messages          ChatMessage[]
  journalEntries    JournalEntry[]
  audioTracks       AudioTrack[]
  characters        Character[]
  assets            Asset[]            @relation("AssetRoom")
  members           RoomMember[]
  assistantMessages AssistantMessage[]
}

/// Persistent player membership — written on invite-join, used for lobby roster
/// and for listing rooms the user was invited to (R-Persistent-Membership).
model RoomMember {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  userId    String   @db.Uuid
  role      String   @db.VarChar(16) @default("Player")
  joinedAt  DateTime @default(now()) @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model Asset {
  id           String   @id @default(uuid()) @db.Uuid
  ownerId      String   @db.Uuid
  roomId       String   @db.Uuid
  mimeType     String   @db.VarChar(128)
  size         BigInt
  // storageKey is the immutable GCS object path (rooms/<uuid>/<kind>/<uuid>.<ext>).
  // It MUST stay UUID-based for storage stability — rename UI mutates `originalName` only.
  storageKey   String   @unique @db.VarChar(256)
  // Display name shown in the asset library. Backfilled from storageKey suffix
  // for rows created before the rename feature; new uploads carry file.originalname.
  originalName String   @default("") @db.VarChar(128)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  owner            User           @relation("AssetOwner", fields: [ownerId], references: [id])
  room             Room           @relation("AssetRoom", fields: [roomId], references: [id], onDelete: Cascade)
  sceneBackgrounds Scene[]        @relation("SceneBackground")
  tokenImages      Token[]        @relation("TokenImage")
  characterPdfs    Character[]    @relation("CharacterPdf")
  journalEntries   JournalEntry[] @relation("JournalAsset")
  audioTracks      AudioTrack[]
}

model Scene {
  id                String   @id @default(uuid()) @db.Uuid
  roomId            String   @db.Uuid
  name              String   @db.VarChar(128)
  backgroundAssetId String?  @db.Uuid
  backgroundFit     String   @default("cover")
  backgroundOffsetX Float    @default(0)
  backgroundOffsetY Float    @default(0)
  backgroundScale   Float    @default(1.0)
  gridSize          Int
  // Scene grid dimensions in cells — used by FoW algorithm A4 (visibility[W][H]).
  gridWidth         Int      @default(40)
  gridHeight        Int      @default(40)
  gridVisible       Boolean  @default(true)
  // FoW shape-list (Ф3.3): array of {id,x,y,w,h,mode,createdAt} composed in
  // createdAt ASC order. null/[] = fully revealed. Replaces legacy fogMaskBase64.
  fogShapes         Json?
  isHidden          Boolean  @default(false)
  isActive          Boolean  @default(false)
  // Current combat round; incremented on wraparound advanceTurn (Ф7.3, A_Initiative).
  currentRound      Int      @default(1)
  // Persisted free-draw strokes (Ф3.4.2). Stored as DrawStroke[] JSON array; null = empty.
  annotations       Json?
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  room            Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  backgroundAsset Asset?             @relation("SceneBackground", fields: [backgroundAssetId], references: [id], onDelete: SetNull)
  tokens          Token[]
  initiativeItems InitiativeEntry[]
  audioTracks     AudioTrack[]

  @@index([roomId])
}

model Token {
  id             String   @id @default(uuid()) @db.Uuid
  sceneId        String   @db.Uuid
  assignedUserId String?  @db.Uuid
  imageAssetId   String?  @db.Uuid
  x              Float
  y              Float
  name           String   @db.VarChar(64)
  hp             Int?
  maxHp          Int?
  color          String?
  statusMarkers  String[] @default([])
  isHidden       Boolean  @default(false)
  // OCC version per algorithm A2 (§2.17.3). Monotonically increasing on every accepted move.
  version        Int      @default(0)
  visionRadius   Int      @default(6)

  scene             Scene            @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  assignedUser      User?            @relation("TokenAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  imageAsset        Asset?           @relation("TokenImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  initiativeEntries InitiativeEntry[] @relation("InitiativeEntryToken")

  @@index([sceneId])
}

model Character {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  roomId      String   @db.Uuid
  name        String   @db.VarChar(128)
  sheetData   Json
  pdfAssetId  String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  owner    User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  room     Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  pdfAsset Asset? @relation("CharacterPdf", fields: [pdfAssetId], references: [id], onDelete: SetNull)
}

model ChatMessage {
  id          String      @id @default(uuid()) @db.Uuid
  roomId      String      @db.Uuid
  senderId    String?     @db.Uuid
  mode        MessageMode
  body        String      @db.Text
  rollPayload Json?
  recipientId String?     @db.Uuid
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)

  room      Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User? @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipient User? @relation("ChatMessageRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt(sort: Desc)])
}

model AudioTrack {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  sceneId   String?  @db.Uuid
  title     String   @db.VarChar(128)
  assetId   String   @db.Uuid
  loop      Boolean    @default(false)
  fadeMs    Int        @default(1500)
  layer     AudioLayer @default(music)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)

  room    Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  scene   Scene? @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

enum JournalVisibility {
  private
  shared
}

model JournalEntry {
  id         String            @id @default(uuid()) @db.Uuid
  roomId     String            @db.Uuid
  authorId   String            @db.Uuid
  title      String            @db.VarChar(128)
  body       String            @db.Text
  visibility JournalVisibility @default(private)
  assetId    String?           @db.Uuid
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(6)

  room       Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author     User               @relation("JournalAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  asset      Asset?             @relation("JournalAsset", fields: [assetId], references: [id], onDelete: SetNull)
  recipients JournalRecipient[]

  @@index([roomId])
}

model JournalRecipient {
  entryId   String   @db.Uuid
  userId    String   @db.Uuid
  grantedAt DateTime @default(now()) @db.Timestamptz(6)

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User         @relation("JournalRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@id([entryId, userId])
}

model InitiativeEntry {
  id         String  @id @default(uuid()) @db.Uuid
  sceneId    String  @db.Uuid
  name       String  @db.VarChar(64)
  initiative Int
  orderIndex Int
  isCurrent  Boolean @default(false)
  tokenId    String? @db.Uuid

  scene Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  token Token? @relation("InitiativeEntryToken", fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([tokenId])
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String   @db.VarChar(128)
  issuedAt         DateTime @default(now()) @db.Timestamptz(6)
  expiresAt        DateTime @db.Timestamptz(6)
  userAgent        String   @db.VarChar(256)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/// Persistent AI assistant chat messages per room (§2.15, Ф8.1).
/// F5-safe: history is loaded from DB on mount, not from Redux only.
model AssistantMessage {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  userId    String?  @db.Uuid
  /// 'user' | 'assistant' | 'system'
  role      String   @db.VarChar(16)
  content   String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  room Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
}
