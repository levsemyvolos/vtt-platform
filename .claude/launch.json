{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "VTT Server (recursing-wing)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vtt/server", "dev"],
      "env": { "PORT": "4002" },
      "port": 4002
    },
    {
      "name": "VTT Client (recursing-wing)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vtt/client", "dev"],
      "env": { "VITE_PORT": "5175", "VITE_SERVER_PORT": "4002" },
      "port": 5175
    }
  ]
}
